<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#"
     xml:base="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dbo="http://dbpedia.org/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vgaccess="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess">
        <dc:creator xml:lang="it">Alex Agliuzza</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-24</dc:date>
        <dc:description xml:lang="it">Ontologia per descrivere videogiochi in relazione alle funzionalita di accessibilita offerte, alle esigenze dei giocatori e ai profili utente supportati.</dc:description>
        <dc:title xml:lang="it">VGAccess: ontologia per la rappresentazione dell&apos;accessibilita nei videogiochi</dc:title>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <vann:preferredNamespacePrefix>vgaccess</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>&lt;http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#&gt;</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="it">Ontologia sviluppata come progetto di modellazione concettuale per il Web Semantico.</rdfs:comment>
        <rdfs:label xml:lang="it">VGAccess</rdfs:label>
    </owl:Ontology>
    


