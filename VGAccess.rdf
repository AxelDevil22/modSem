        <rdfs:label xml:lang="it">Videogioco accessibile per utenti con esigenze motorie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiUditivi -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiUditivi">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaUditiva"/>
                    </owl:Restriction>
                </owl:intersectionOf>
