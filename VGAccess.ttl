                                                                <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                               rdfs:comment "Funzionalita che limita elementi visivi, sonori o interattivi potenzialmente sovraccaricanti."@it ;
                                               rdfs:label "Riduzione degli stimoli"@it .


###  http://example.org/vgaccess#RimappaturaComandi
<http://example.org/vgaccess#RimappaturaComandi> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaMotoria> ;
                                                 owl:disjointWith <http://example.org/vgaccess#Sottotitoli> ,
                                                                  <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                                  <http://example.org/vgaccess#TutorialGuidato> ,
                                                                  <http://example.org/vgaccess#Videogioco> ,
                                                                  <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                  <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                  <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                  <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                  <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                  <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                 rdfs:comment "Funzionalita che consente di modificare l'associazione tra azioni di gioco e dispositivi o pulsanti di input."@it ;
                                                 rdfs:label "Rimappatura dei comandi"@it .


###  http://example.org/vgaccess#Sottotitoli
<http://example.org/vgaccess#Sottotitoli> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaUditiva> ;
                                          owl:disjointWith <http://example.org/vgaccess#TutorialGuidato> ,
                                                           <http://example.org/vgaccess#Videogioco> ,
                                                           <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                           <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                           <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                           <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                           <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                           <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                          rdfs:comment "Funzionalita che rende disponibili in forma testuale dialoghi o informazioni sonore."@it ;
                                          rdfs:label "Sottotitoli"@it .


###  http://example.org/vgaccess#SottotitoliAvanzati
<http://example.org/vgaccess#SottotitoliAvanzati> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://example.org/vgaccess#Sottotitoli> ;
                                                  owl:disjointWith <http://example.org/vgaccess#TutorialGuidato> ,
                                                                   <http://example.org/vgaccess#Videogioco> ,
                                                                   <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                   <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                   <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                   <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                   <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                   <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                  rdfs:comment "Sottotitoli arricchiti con informazioni aggiuntive, personalizzazione o indicazione dei parlanti."@it ;
                                                  rdfs:label "Sottotitoli avanzati"@it .


###  http://example.org/vgaccess#Sviluppatore
<http://example.org/vgaccess#Sviluppatore> rdf:type owl:Class ;
                                           rdfs:comment "Soggetto o organizzazione responsabile dello sviluppo di un videogioco."@it ;
                                           rdfs:label "Sviluppatore"@it ;
                                           <http://www.w3.org/2004/02/skos/core#closeMatch> <http://www.wikidata.org/entity/Q210167> .


###  http://example.org/vgaccess#TutorialGuidato
<http://example.org/vgaccess#TutorialGuidato> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaCognitiva> ;
                                              owl:disjointWith <http://example.org/vgaccess#Videogioco> ,
                                                               <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                               <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                              rdfs:comment "Funzionalita che accompagna il giocatore nell'apprendimento di comandi, regole o obiettivi."@it ;
                                              rdfs:label "Tutorial guidato"@it .


###  http://example.org/vgaccess#Videogioco
<http://example.org/vgaccess#Videogioco> rdf:type owl:Class ;
                                         rdfs:comment "Opera videoludica descritta dal punto di vista delle sue funzionalita di accessibilita e delle informazioni descrittive principali."@it ;
                                         rdfs:label "Videogioco"@it ;
                                         <http://www.w3.org/2004/02/skos/core#closeMatch> <http://dbpedia.org/ontology/VideoGame> ,
                                                                                          <http://www.wikidata.org/entity/Q7889> .


###  http://example.org/vgaccess#VideogiocoAccessibile
<http://example.org/vgaccess#VideogiocoAccessibile> rdf:type owl:Class ;
                                                    owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                 owl:someValuesFrom <http://example.org/vgaccess#FunzionalitaAccessibilita>
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ] ;
                                                    rdfs:subClassOf <http://example.org/vgaccess#Videogioco> ;
                                                    rdfs:comment "Videogioco che possiede almeno una funzionalita di accessibilita."@it ;
                                                    rdfs:label "Videogioco accessibile"@it .


###  http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi
<http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> rdf:type owl:Class ;
                                                                      owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                   owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                                   owl:someValuesFrom <http://example.org/vgaccess#FunzionalitaCognitiva>
                                                                                                                 ]
                                                                                                               ) ;
                                                                                            rdf:type owl:Class
                                                                                          ] ;
                                                                      rdfs:subClassOf <http://example.org/vgaccess#VideogiocoAccessibile> ;
                                                                      rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita cognitiva."@it ;
                                                                      rdfs:label "Videogioco accessibile per utenti con esigenze cognitive"@it .


###  http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori
<http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> rdf:type owl:Class ;
                                                                   owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                                owl:someValuesFrom <http://example.org/vgaccess#FunzionalitaMotoria>
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ] ;
                                                                   rdfs:subClassOf <http://example.org/vgaccess#VideogiocoAccessibile> ;
                                                                   rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita motoria."@it ;
                                                                   rdfs:label "Videogioco accessibile per utenti con esigenze motorie"@it .


###  http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi
<http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> rdf:type owl:Class ;
                                                                    owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                                 owl:someValuesFrom <http://example.org/vgaccess#FunzionalitaUditiva>
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdf:type owl:Class
                                                                                        ] ;
                                                                    rdfs:subClassOf <http://example.org/vgaccess#VideogiocoAccessibile> ;
                                                                    rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita uditiva."@it ;
                                                                    rdfs:label "Videogioco accessibile per utenti con esigenze uditive"@it .


###  http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi
<http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> rdf:type owl:Class ;
                                                                   owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                                owl:someValuesFrom <http://example.org/vgaccess#FunzionalitaVisiva>
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ] ;
                                                                   rdfs:subClassOf <http://example.org/vgaccess#VideogiocoAccessibile> ;
                                                                   rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita visiva."@it ;
                                                                   rdfs:label "Videogioco accessibile per utenti con esigenze visive"@it .


###  http://example.org/vgaccess#VideogiocoAltamenteAccessibile
<http://example.org/vgaccess#VideogiocoAltamenteAccessibile> rdf:type owl:Class ;
                                                             owl:equivalentClass [ owl:intersectionOf ( <http://example.org/vgaccess#Videogioco>
                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                                                                                          owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                                                                                                          owl:onClass <http://example.org/vgaccess#FunzionalitaAccessibilita>
                                                                                                        ]
                                                                                                      ) ;
                                                                                   rdf:type owl:Class
                                                                                 ] ;
                                                             rdfs:subClassOf <http://example.org/vgaccess#VideogiocoAccessibile> ;
                                                             rdfs:comment "Videogioco che possiede almeno quattro funzionalita di accessibilita."@it ;
                                                             rdfs:label "Videogioco altamente accessibile"@it .


