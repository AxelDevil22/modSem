@prefix : <http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess> .

<http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess> rdf:type owl:Ontology ;
                                                                      <http://purl.org/dc/elements/1.1/creator> "Alex Agliuzza"@it ;
                                                                      <http://purl.org/dc/elements/1.1/date> "2026-05-24"^^xsd:date ;
                                                                      <http://purl.org/dc/elements/1.1/description> "Ontologia per descrivere videogiochi in relazione alle funzionalita di accessibilita offerte, alle esigenze dei giocatori e ai profili utente supportati."@it ;
                                                                      <http://purl.org/dc/elements/1.1/title> "VGAccess: ontologia per la rappresentazione dell'accessibilita nei videogiochi"@it ;
                                                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "vgaccess" ;
                                                                      <http://purl.org/vocab/vann/preferredNamespaceUri> "<http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#>" ;
                                                                      rdfs:comment "Ontologia sviluppata come progetto di modellazione concettuale per il Web Semantico."@it ;
                                                                      rdfs:label "VGAccess"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .





#################################################################
#    Object Properties
#################################################################

###  http://example.org/vgaccess#adattoAProfilo
<http://example.org/vgaccess#adattoAProfilo> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                             rdfs:range <http://example.org/vgaccess#ProfiloGiocatore> ;
                                             rdfs:comment "Collega un videogioco a un profilo giocatore per cui il gioco puo essere considerato adatto."@it ;
                                             rdfs:label "adatto a profilo"@it .


###  http://example.org/vgaccess#disponibileSu
<http://example.org/vgaccess#disponibileSu> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                            rdfs:range <http://example.org/vgaccess#Piattaforma> ;
                                            rdfs:comment "Collega un videogioco alla piattaforma su cui e disponibile."@it ;
                                            rdfs:label "disponibile su"@it .


###  http://example.org/vgaccess#eFunzionalitaDi
<http://example.org/vgaccess#eFunzionalitaDi> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf <http://example.org/vgaccess#haFunzionalitaAccessibilita> ;
                                              rdfs:domain <http://example.org/vgaccess#FunzionalitaAccessibilita> ;
                                              rdfs:range <http://example.org/vgaccess#Videogioco> ;
                                              rdfs:comment "Collega una funzionalita di accessibilita al videogioco in cui e presente."@it ;
                                              rdfs:label "e funzionalita di"@it .


###  http://example.org/vgaccess#haEsigenzaAccessibilita
<http://example.org/vgaccess#haEsigenzaAccessibilita> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://example.org/vgaccess#ProfiloGiocatore> ;
                                                      rdfs:range <http://example.org/vgaccess#EsigenzaAccessibilita> ;
                                                      rdfs:comment "Collega un profilo giocatore a una sua esigenza di accessibilita."@it ;
                                                      rdfs:label "ha esigenza di accessibilita"@it .


###  http://example.org/vgaccess#haFunzionalitaAccessibilita
<http://example.org/vgaccess#haFunzionalitaAccessibilita> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                          rdfs:range <http://example.org/vgaccess#FunzionalitaAccessibilita> ;
                                                          rdfs:comment "Collega un videogioco a una funzionalita di accessibilita presente nel gioco."@it ;
                                                          rdfs:label "ha funzionalita di accessibilita"@it .


###  http://example.org/vgaccess#haLivelloAccessibilita
<http://example.org/vgaccess#haLivelloAccessibilita> rdf:type owl:ObjectProperty ,
                                                              owl:FunctionalProperty ;
                                                     rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                     rdfs:range <http://example.org/vgaccess#LivelloAccessibilita> ;
                                                     rdfs:comment "Collega un videogioco a un unico livello sintetico di accessibilita."@it ;
                                                     rdfs:label "ha livello di accessibilita"@it .


###  http://example.org/vgaccess#piuSpecificoDi
<http://example.org/vgaccess#piuSpecificoDi> rdf:type owl:ObjectProperty ,
                                                      owl:TransitiveProperty ;
                                             rdfs:domain <http://example.org/vgaccess#FunzionalitaAccessibilita> ;
                                             rdfs:range <http://example.org/vgaccess#FunzionalitaAccessibilita> ;
                                             rdfs:comment "Relazione transitiva usata per rappresentare gerarchie concettuali tra funzionalita o bisogni."@it ;
                                             rdfs:label "piu specifico di"@it .


###  http://example.org/vgaccess#pubblicatoDa
<http://example.org/vgaccess#pubblicatoDa> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                           rdfs:range <http://example.org/vgaccess#Publisher> ;
                                           rdfs:comment "Collega un videogioco al suo publisher."@it ;
                                           rdfs:label "pubblicato da"@it .


###  http://example.org/vgaccess#supportaEsigenza
<http://example.org/vgaccess#supportaEsigenza> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://example.org/vgaccess#FunzionalitaAccessibilita> ;
                                               rdfs:range <http://example.org/vgaccess#EsigenzaAccessibilita> ;
                                               rdfs:comment "Collega una funzionalita di accessibilita all'esigenza del giocatore che essa supporta."@it ;
                                               rdfs:label "supporta esigenza"@it .


###  http://example.org/vgaccess#supportaEsigenzaGiocatore
<http://example.org/vgaccess#supportaEsigenzaGiocatore> rdf:type owl:ObjectProperty ,
                                                                 owl:AsymmetricProperty ,
                                                                 owl:IrreflexiveProperty ;
                                                        rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                        rdfs:range <http://example.org/vgaccess#EsigenzaAccessibilita> ;
                                                        owl:propertyChainAxiom ( <http://example.org/vgaccess#haFunzionalitaAccessibilita>
                                                                                 <http://example.org/vgaccess#supportaEsigenza>
                                                                               ) ;
                                                        rdfs:comment "Collega un videogioco a un'esigenza del giocatore inferita tramite le sue funzionalita di accessibilita."@it ;
                                                        rdfs:label "supporta esigenza del giocatore"@it .


###  http://example.org/vgaccess#sviluppatoDa
<http://example.org/vgaccess#sviluppatoDa> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                           rdfs:range <http://example.org/vgaccess#Sviluppatore> ;
                                           rdfs:comment "Collega un videogioco al suo sviluppatore."@it ;
                                           rdfs:label "sviluppato da"@it .


#################################################################
#    Data properties
#################################################################

###  http://example.org/vgaccess#haAnnoPubblicazione
<http://example.org/vgaccess#haAnnoPubblicazione> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                  rdfs:range xsd:gYear ;
                                                  rdfs:comment "Anno di pubblicazione del videogioco."@it ;
                                                  rdfs:label "ha anno di pubblicazione"@it .


###  http://example.org/vgaccess#haDescrizioneBreve
<http://example.org/vgaccess#haDescrizioneBreve> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                 rdfs:range rdf:langString ;
                                                 rdfs:comment "Breve descrizione testuale del videogioco o delle sue caratteristiche rilevanti."@it ;
                                                 rdfs:label "ha descrizione breve"@it .


###  http://example.org/vgaccess#haPunteggioAccessibilita
<http://example.org/vgaccess#haPunteggioAccessibilita> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                       rdfs:range xsd:integer ;
                                                       rdfs:comment "Valore numerico sintetico usato per indicare il livello di accessibilita del videogioco."@it ;
                                                       rdfs:label "ha punteggio di accessibilita"@it .


###  http://example.org/vgaccess#haTitoloPrincipale
<http://example.org/vgaccess#haTitoloPrincipale> rdf:type owl:DatatypeProperty ,
                                                          owl:FunctionalProperty ;
                                                 rdfs:domain <http://example.org/vgaccess#Videogioco> ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Titolo principale del videogioco, espresso come stringa."@it ;
                                                 rdfs:label "ha titolo principale"@it .


#################################################################
#    Classes
#################################################################

###  http://example.org/vgaccess#AltoContrasto
<http://example.org/vgaccess#AltoContrasto> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaVisiva> ;
                                            owl:disjointWith <http://example.org/vgaccess#AssistMode> ,
                                                             <http://example.org/vgaccess#ControlliSemplificati> ,
                                                             <http://example.org/vgaccess#DifficoltaPersonalizzabile> ,
                                                             <http://example.org/vgaccess#EsigenzaAccessibilita> ,
                                                             <http://example.org/vgaccess#EsigenzaCognitiva> ,
                                                             <http://example.org/vgaccess#EsigenzaMotoria> ,
                                                             <http://example.org/vgaccess#EsigenzaUditiva> ,
                                                             <http://example.org/vgaccess#EsigenzaVisiva> ,
                                                             <http://example.org/vgaccess#FunzionalitaCognitiva> ,
                                                             <http://example.org/vgaccess#FunzionalitaMotoria> ,
                                                             <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                             <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                             <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                             <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                             <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                             <http://example.org/vgaccess#Piattaforma> ,
                                                             <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                             <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                             <http://example.org/vgaccess#RimappaturaComandi> ,
                                                             <http://example.org/vgaccess#Sottotitoli> ,
                                                             <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                             <http://example.org/vgaccess#TutorialGuidato> ,
                                                             <http://example.org/vgaccess#Videogioco> ,
                                                             <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                             <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                             <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                             <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                             <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                             <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                            rdfs:comment "Funzionalita che aumenta il contrasto visivo tra elementi di gioco, interfaccia e sfondo."@it ;
                                            rdfs:label "Alto contrasto"@it .


###  http://example.org/vgaccess#AssistMode
<http://example.org/vgaccess#AssistMode> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaMotoria> ;
                                         owl:disjointWith <http://example.org/vgaccess#ControlliSemplificati> ,
                                                          <http://example.org/vgaccess#DifficoltaPersonalizzabile> ,
                                                          <http://example.org/vgaccess#EsigenzaAccessibilita> ,
                                                          <http://example.org/vgaccess#EsigenzaCognitiva> ,
                                                          <http://example.org/vgaccess#EsigenzaMotoria> ,
                                                          <http://example.org/vgaccess#EsigenzaUditiva> ,
                                                          <http://example.org/vgaccess#EsigenzaVisiva> ,
                                                          <http://example.org/vgaccess#FunzionalitaCognitiva> ,
                                                          <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                          <http://example.org/vgaccess#FunzionalitaVisiva> ,
                                                          <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                          <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                          <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                          <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                          <http://example.org/vgaccess#Piattaforma> ,
                                                          <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                          <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                          <http://example.org/vgaccess#RimappaturaComandi> ,
                                                          <http://example.org/vgaccess#Sottotitoli> ,
                                                          <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                          <http://example.org/vgaccess#TutorialGuidato> ,
                                                          <http://example.org/vgaccess#Videogioco> ,
                                                          <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                          <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                         rdfs:comment "Modalita di assistenza che modifica alcune regole o parametri di gioco per ridurre barriere di interazione."@it ;
                                         rdfs:label "Assist mode"@it .


###  http://example.org/vgaccess#ControlliSemplificati
<http://example.org/vgaccess#ControlliSemplificati> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaMotoria> ;
                                                    owl:disjointWith <http://example.org/vgaccess#DifficoltaPersonalizzabile> ,
                                                                     <http://example.org/vgaccess#EsigenzaAccessibilita> ,
                                                                     <http://example.org/vgaccess#EsigenzaCognitiva> ,
                                                                     <http://example.org/vgaccess#EsigenzaMotoria> ,
                                                                     <http://example.org/vgaccess#EsigenzaUditiva> ,
                                                                     <http://example.org/vgaccess#EsigenzaVisiva> ,
                                                                     <http://example.org/vgaccess#FunzionalitaCognitiva> ,
                                                                     <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                                     <http://example.org/vgaccess#FunzionalitaVisiva> ,
                                                                     <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                                     <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                                     <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                                     <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                                     <http://example.org/vgaccess#Piattaforma> ,
                                                                     <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                                     <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                                     <http://example.org/vgaccess#RimappaturaComandi> ,
                                                                     <http://example.org/vgaccess#Sottotitoli> ,
                                                                     <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                                     <http://example.org/vgaccess#TutorialGuidato> ,
                                                                     <http://example.org/vgaccess#Videogioco> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                    rdfs:comment "Funzionalita che riduce la complessita o la precisione richiesta per l'interazione motoria."@it ;
                                                    rdfs:label "Controlli semplificati"@it .


###  http://example.org/vgaccess#DifficoltaPersonalizzabile
<http://example.org/vgaccess#DifficoltaPersonalizzabile> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://example.org/vgaccess#FunzionalitaCognitiva> ;
                                                         owl:disjointWith <http://example.org/vgaccess#EsigenzaAccessibilita> ,
                                                                          <http://example.org/vgaccess#EsigenzaCognitiva> ,
                                                                          <http://example.org/vgaccess#EsigenzaMotoria> ,
                                                                          <http://example.org/vgaccess#EsigenzaUditiva> ,
                                                                          <http://example.org/vgaccess#EsigenzaVisiva> ,
                                                                          <http://example.org/vgaccess#FunzionalitaMotoria> ,
                                                                          <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                                          <http://example.org/vgaccess#FunzionalitaVisiva> ,
                                                                          <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                                          <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                                          <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                                          <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                                          <http://example.org/vgaccess#Piattaforma> ,
                                                                          <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                                          <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                                          <http://example.org/vgaccess#RimappaturaComandi> ,
                                                                          <http://example.org/vgaccess#Sottotitoli> ,
                                                                          <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                                          <http://example.org/vgaccess#TutorialGuidato> ,
                                                                          <http://example.org/vgaccess#Videogioco> ,
                                                                          <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                          <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                          <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                         rdfs:comment "Funzionalita che consente di modificare parametri della difficolta per adattare l'esperienza alle esigenze del giocatore."@it ;
                                                         rdfs:label "Difficolta personalizzabile"@it .


###  http://example.org/vgaccess#EsigenzaAccessibilita
<http://example.org/vgaccess#EsigenzaAccessibilita> rdf:type owl:Class ;
                                                    owl:disjointWith <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                                     <http://example.org/vgaccess#FunzionalitaCognitiva> ,
                                                                     <http://example.org/vgaccess#FunzionalitaMotoria> ,
                                                                     <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                                     <http://example.org/vgaccess#FunzionalitaVisiva> ,
                                                                     <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                                     <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                                     <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                                     <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                                     <http://example.org/vgaccess#Piattaforma> ,
                                                                     <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                                     <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                                     <http://example.org/vgaccess#RimappaturaComandi> ,
                                                                     <http://example.org/vgaccess#Sottotitoli> ,
                                                                     <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                                     <http://example.org/vgaccess#TutorialGuidato> ,
                                                                     <http://example.org/vgaccess#Videogioco> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                     <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                    rdfs:comment "Necessita o requisito del giocatore a cui una funzionalita di accessibilita puo rispondere."@it ;
                                                    rdfs:label "Esigenza di accessibilita"@it .


###  http://example.org/vgaccess#EsigenzaCognitiva
<http://example.org/vgaccess#EsigenzaCognitiva> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://example.org/vgaccess#EsigenzaAccessibilita> ;
                                                owl:disjointWith <http://example.org/vgaccess#EsigenzaMotoria> ,
                                                                 <http://example.org/vgaccess#EsigenzaUditiva> ,
                                                                 <http://example.org/vgaccess#EsigenzaVisiva> ,
                                                                 <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                                 <http://example.org/vgaccess#FunzionalitaCognitiva> ,
                                                                 <http://example.org/vgaccess#FunzionalitaMotoria> ,
                                                                 <http://example.org/vgaccess#FunzionalitaUditiva> ,
                                                                 <http://example.org/vgaccess#FunzionalitaVisiva> ,
                                                                 <http://example.org/vgaccess#IndicatoriVisiviAudio> ,
                                                                 <http://example.org/vgaccess#IngrandimentoTesto> ,
                                                                 <http://example.org/vgaccess#LivelloAccessibilita> ,
                                                                 <http://example.org/vgaccess#ModalitaDaltonismo> ,
                                                                 <http://example.org/vgaccess#Piattaforma> ,
                                                                 <http://example.org/vgaccess#ProfiloGiocatore> ,
                                                                 <http://example.org/vgaccess#RiduzioneStimoli> ,
                                                                 <http://example.org/vgaccess#RimappaturaComandi> ,
                                                                 <http://example.org/vgaccess#Sottotitoli> ,
                                                                 <http://example.org/vgaccess#SottotitoliAvanzati> ,
                                                                 <http://example.org/vgaccess#TutorialGuidato> ,
                                                                 <http://example.org/vgaccess#Videogioco> ,
                                                                 <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                                                 <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                                                 <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ,
                                                                 <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiUditivi> ,
                                                                 <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiVisivi> ,
                                                                 <http://example.org/vgaccess#VideogiocoAltamenteAccessibile> ;
                                                rdfs:comment "Esigenza legata alla comprensione, alla memoria, all'attenzione o alla gestione della complessita."@it ;
