###  http://example.org/vgaccess#AccessibilitaBase
<http://example.org/vgaccess#AccessibilitaBase> rdf:type owl:NamedIndividual ,
                                                         <http://example.org/vgaccess#LivelloAccessibilita> ;
                                                rdfs:comment "Livello sintetico che indica la presenza di un insieme limitato di funzionalita di accessibilita."@it ;
                                                rdfs:label "Accessibilita base"@it .


###  http://example.org/vgaccess#AccessibilitaElevata
<http://example.org/vgaccess#AccessibilitaElevata> rdf:type owl:NamedIndividual ,
                                                            <http://example.org/vgaccess#LivelloAccessibilita> ;
                                                   rdfs:comment "Livello sintetico che indica la presenza di un insieme ampio di funzionalita di accessibilita."@it ;
                                                   rdfs:label "Accessibilita elevata"@it .


###  http://example.org/vgaccess#AccessibilitaMedia
<http://example.org/vgaccess#AccessibilitaMedia> rdf:type owl:NamedIndividual ,
                                                          <http://example.org/vgaccess#LivelloAccessibilita> ;
                                                 rdfs:comment "Livello sintetico che indica la presenza di un insieme intermedio di funzionalita di accessibilita."@it ;
                                                 rdfs:label "Accessibilita media"@it .


###  http://example.org/vgaccess#AltoContrastoTLOU2
<http://example.org/vgaccess#AltoContrastoTLOU2> rdf:type owl:NamedIndividual ,
                                                          <http://example.org/vgaccess#AltoContrasto> ,
                                                          <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                          <http://example.org/vgaccess#FunzionalitaVisiva> ;
                                                 <http://example.org/vgaccess#eFunzionalitaDi> <http://example.org/vgaccess#TheLastOfUsPartII> ;
                                                 <http://example.org/vgaccess#supportaEsigenza> <http://example.org/vgaccess#PercezioneElementiVisivi> ;
                                                 rdfs:comment "Istanza di funzionalita di alto contrasto presente nell'esempio The Last of Us Part II."@it ;
                                                 rdfs:label "Modalita alto contrasto di The Last of Us Part II"@it .


###  http://example.org/vgaccess#AssistModeCeleste
<http://example.org/vgaccess#AssistModeCeleste> rdf:type owl:NamedIndividual ,
                                                         <http://example.org/vgaccess#AssistMode> ,
                                                         <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                         <http://example.org/vgaccess#FunzionalitaMotoria> ;
                                                <http://example.org/vgaccess#eFunzionalitaDi> <http://example.org/vgaccess#Celeste> ;
                                                <http://example.org/vgaccess#supportaEsigenza> <http://example.org/vgaccess#GestioneCaricoCognitivo> ,
                                                                                               <http://example.org/vgaccess#RiduzioneBarriereMotorie> ;
                                                rdfs:comment "Istanza di modalita assistita presente nell'esempio Celeste."@it ;
                                                rdfs:label "Assist mode di Celeste"@it .


###  http://example.org/vgaccess#AssistModeTLOU2
<http://example.org/vgaccess#AssistModeTLOU2> rdf:type owl:NamedIndividual ,
                                                       <http://example.org/vgaccess#AssistMode> ,
                                                       <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                       <http://example.org/vgaccess#FunzionalitaMotoria> ;
                                              <http://example.org/vgaccess#eFunzionalitaDi> <http://example.org/vgaccess#TheLastOfUsPartII> ;
                                              <http://example.org/vgaccess#supportaEsigenza> <http://example.org/vgaccess#RiduzioneBarriereMotorie> ;
                                              rdfs:comment "Istanza di modalita assistita presente nell'esempio The Last of Us Part II."@it ;
                                              rdfs:label "Assist mode di The Last of Us Part II"@it .


###  http://example.org/vgaccess#Celeste
<http://example.org/vgaccess#Celeste> rdf:type owl:NamedIndividual ,
                                               <http://example.org/vgaccess#Videogioco> ,
                                               <http://example.org/vgaccess#VideogiocoAccessibile> ,
                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiCognitivi> ,
                                               <http://example.org/vgaccess#VideogiocoAccessibilePerUtentiMotori> ;
                                      <http://example.org/vgaccess#disponibileSu> <http://example.org/vgaccess#NintendoSwitch> ;
                                      <http://example.org/vgaccess#haFunzionalitaAccessibilita> <http://example.org/vgaccess#AssistModeCeleste> ,
                                                                                                <http://example.org/vgaccess#ControlliSemplificatiCeleste> ,
                                                                                                <http://example.org/vgaccess#DifficoltaPersonalizzabileCeleste> ;
                                      <http://example.org/vgaccess#haLivelloAccessibilita> <http://example.org/vgaccess#AccessibilitaMedia> ;
                                      <http://example.org/vgaccess#pubblicatoDa> <http://example.org/vgaccess#ExtremelyOKGames> ;
                                      <http://example.org/vgaccess#supportaEsigenzaGiocatore> <http://example.org/vgaccess#GestioneCaricoCognitivo> ,
                                                                                              <http://example.org/vgaccess#RiduzioneBarriereMotorie> ;
                                      <http://example.org/vgaccess#sviluppatoDa> <http://example.org/vgaccess#ExtremelyOKGames> ;
                                      <http://example.org/vgaccess#haAnnoPubblicazione> "2018"^^xsd:gYear ;
                                                                                
                                      <http://example.org/vgaccess#haDescrizioneBreve> "Videogioco usato come esempio per rappresentare funzionalita di assistenza, personalizzazione della difficolta e semplificazione dei controlli."@it ;
                                      <http://example.org/vgaccess#haPunteggioAccessibilita> 4 ;
                                      <http://example.org/vgaccess#haTitoloPrincipale> "Celeste" ;
                                      rdfs:comment "Esempio completo di videogioco con funzionalita di accessibilita motoria e cognitiva."@it ;
                                      rdfs:label "Celeste"@it .


###  http://example.org/vgaccess#ComprensioneDialoghiSenzaAudio
<http://example.org/vgaccess#ComprensioneDialoghiSenzaAudio> rdf:type owl:NamedIndividual ,
