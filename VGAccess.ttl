###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco
vgaccess:Videogioco rdf:type owl:Class ;
                    rdfs:comment "Opera videoludica descritta dal punto di vista delle sue funzionalita di accessibilita e delle informazioni descrittive principali."@it ;
                    rdfs:label "Videogioco"@it ;
                    skos:closeMatch <http://dbpedia.org/ontology/VideoGame> ,
                                    <http://www.wikidata.org/entity/Q7889> .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibile
vgaccess:VideogiocoAccessibile rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                            owl:someValuesFrom vgaccess:FunzionalitaAccessibilita
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf vgaccess:Videogioco ;
                               rdfs:comment "Videogioco che possiede almeno una funzionalita di accessibilita."@it ;
                               rdfs:label "Videogioco accessibile"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiCognitivi
vgaccess:VideogiocoAccessibilePerUtentiCognitivi rdf:type owl:Class ;
                                                 owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                                              owl:someValuesFrom vgaccess:FunzionalitaCognitiva
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ] ;
                                                 rdfs:subClassOf vgaccess:VideogiocoAccessibile ;
                                                 rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita cognitiva."@it ;
                                                 rdfs:label "Videogioco accessibile per utenti con esigenze cognitive"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiMotori
vgaccess:VideogiocoAccessibilePerUtentiMotori rdf:type owl:Class ;
                                              owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                                           owl:someValuesFrom vgaccess:FunzionalitaMotoria
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ] ;
                                              rdfs:subClassOf vgaccess:VideogiocoAccessibile ;
                                              rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita motoria."@it ;
                                              rdfs:label "Videogioco accessibile per utenti con esigenze motorie"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiUditivi
vgaccess:VideogiocoAccessibilePerUtentiUditivi rdf:type owl:Class ;
                                               owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                                            owl:someValuesFrom vgaccess:FunzionalitaUditiva
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ] ;
                                               rdfs:subClassOf vgaccess:VideogiocoAccessibile ;
                                               rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita uditiva."@it ;
                                               rdfs:label "Videogioco accessibile per utenti con esigenze uditive"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibilePerUtentiVisivi
vgaccess:VideogiocoAccessibilePerUtentiVisivi rdf:type owl:Class ;
                                              owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                                           owl:someValuesFrom vgaccess:FunzionalitaVisiva
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ] ;
                                              rdfs:subClassOf vgaccess:VideogiocoAccessibile ;
                                              rdfs:comment "Videogioco che offre almeno una funzionalita utile a esigenze di accessibilita visiva."@it ;
                                              rdfs:label "Videogioco accessibile per utenti con esigenze visive"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAltamenteAccessibile
vgaccess:VideogiocoAltamenteAccessibile rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( vgaccess:Videogioco
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty vgaccess:haFunzionalitaAccessibilita ;
                                                                                     owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                                                                                     owl:onClass vgaccess:FunzionalitaAccessibilita
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf vgaccess:VideogiocoAccessibile ;
                                        rdfs:comment "Videogioco che possiede almeno quattro funzionalita di accessibilita."@it ;
                                        rdfs:label "Videogioco altamente accessibile"@it .


