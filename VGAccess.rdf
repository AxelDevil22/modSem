    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#adattoAProfilo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#adattoAProfilo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ProfiloGiocatore"/>
        <rdfs:comment xml:lang="it">Collega un videogioco a un profilo giocatore per cui il gioco puo essere considerato adatto.</rdfs:comment>
        <rdfs:label xml:lang="it">adatto a profilo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#classifica -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#classifica">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Relazione inversa di eClassificatoDa: collega un concetto di classificazione ai videogiochi che esso descrive o classifica</rdfs:comment>
        <rdfs:label xml:lang="it">classifica</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#disponibileSu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#disponibileSu">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Piattaforma"/>
        <rdfs:comment xml:lang="it">Collega un videogioco alla piattaforma su cui e disponibile.</rdfs:comment>
        <rdfs:label xml:lang="it">disponibile su</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione"/>
        <rdfs:comment xml:lang="it">Relazione che collega un videogioco a un concetto usato per descriverne o classificarne le caratteristiche di accessibilità</rdfs:comment>
        <rdfs:label xml:lang="it">eClassificatoDa</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eFunzionalitaDi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eFunzionalitaDi">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Collega una funzionalita di accessibilita al videogioco in cui e presente.</rdfs:comment>
        <rdfs:label xml:lang="it">e funzionalita di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haEsigenzaAccessibilita -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haEsigenzaAccessibilita">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ProfiloGiocatore"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Collega un profilo giocatore a una sua esigenza di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">ha esigenza di accessibilita</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Collega un videogioco a una funzionalita di accessibilita presente nel gioco.</rdfs:comment>
        <rdfs:label xml:lang="it">ha funzionalita di accessibilita</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haLivelloAccessibilita -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haLivelloAccessibilita">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#LivelloAccessibilita"/>
        <rdfs:comment xml:lang="it">Collega un videogioco a un unico livello sintetico di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">ha livello di accessibilita</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#piuSpecificoDi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#piuSpecificoDi">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Relazione transitiva usata per rappresentare gerarchie concettuali tra funzionalita o bisogni.</rdfs:comment>
        <rdfs:label xml:lang="it">piu specifico di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#pubblicatoDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#pubblicatoDa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Publisher"/>
        <rdfs:comment xml:lang="it">Collega un videogioco al suo publisher.</rdfs:comment>
        <rdfs:label xml:lang="it">pubblicato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenza -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenza">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Collega una funzionalita di accessibilita all&apos;esigenza del giocatore che essa supporta.</rdfs:comment>
        <rdfs:label xml:lang="it">supporta esigenza</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenzaGiocatore -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenzaGiocatore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eClassificatoDa"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenza"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="it">Collega un videogioco a un&apos;esigenza del giocatore inferita tramite le sue funzionalita di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">supporta esigenza del giocatore</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#sviluppatoDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#sviluppatoDa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sviluppatore"/>
        <rdfs:comment xml:lang="it">Collega un videogioco al suo sviluppatore.</rdfs:comment>
        <rdfs:label xml:lang="it">sviluppato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haAnnoPubblicazione -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haAnnoPubblicazione">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="it">Anno di pubblicazione del videogioco.</rdfs:comment>
        <rdfs:label xml:lang="it">ha anno di pubblicazione</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haDescrizioneBreve -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haDescrizioneBreve">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="it">Breve descrizione testuale del videogioco o delle sue caratteristiche rilevanti.</rdfs:comment>
        <rdfs:label xml:lang="it">ha descrizione breve</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haPunteggioAccessibilita -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haPunteggioAccessibilita">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Valore numerico sintetico usato per indicare il livello di accessibilita del videogioco.</rdfs:comment>
        <rdfs:label xml:lang="it">ha punteggio di accessibilita</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haTitoloPrincipale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haTitoloPrincipale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Titolo principale del videogioco, espresso come stringa.</rdfs:comment>
        <rdfs:label xml:lang="it">ha titolo principale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AltoContrasto -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AltoContrasto">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaVisiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che aumenta il contrasto visivo tra elementi di gioco, interfaccia e sfondo.</rdfs:comment>
        <rdfs:label xml:lang="it">Alto contrasto</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AssistMode -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AssistMode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaMotoria"/>
        <rdfs:comment xml:lang="it">Modalita di assistenza che modifica alcune regole o parametri di gioco per ridurre barriere di interazione.</rdfs:comment>
        <rdfs:label xml:lang="it">Assist mode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione">
        <rdfs:comment>Concetto utilizzato per classificare videogiochi, funzionalità o profili rispetto al dominio dell&apos;accessibilità.</rdfs:comment>
        <rdfs:label>ConcettoDiClassificazione</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ControlliSemplificati -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ControlliSemplificati">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaMotoria"/>
        <rdfs:comment xml:lang="it">Funzionalita che riduce la complessita o la precisione richiesta per l&apos;interazione motoria.</rdfs:comment>
        <rdfs:label xml:lang="it">Controlli semplificati</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#DifficoltaPersonalizzabile -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#DifficoltaPersonalizzabile">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaCognitiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che consente di modificare parametri della difficolta per adattare l&apos;esperienza alle esigenze del giocatore.</rdfs:comment>
        <rdfs:label xml:lang="it">Difficolta personalizzabile</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#LivelloAccessibilita"/>
        <rdfs:comment xml:lang="it">Necessita o requisito del giocatore a cui una funzionalita di accessibilita puo rispondere.</rdfs:comment>
        <rdfs:label xml:lang="it">Esigenza di accessibilita</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaCognitiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaCognitiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Esigenza legata alla comprensione, alla memoria, all&apos;attenzione o alla gestione della complessita.</rdfs:comment>
        <rdfs:label xml:lang="it">Esigenza cognitiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaMotoria -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaMotoria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Esigenza legata all&apos;interazione fisica con controlli, periferiche o azioni di gioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Esigenza motoria</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaUditiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaUditiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Esigenza legata alla fruizione di suoni, dialoghi e feedback audio.</rdfs:comment>
        <rdfs:label xml:lang="it">Esigenza uditiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaVisiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaVisiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita"/>
        <rdfs:comment xml:lang="it">Esigenza legata alla percezione visiva dei contenuti di gioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Esigenza visiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#LivelloAccessibilita"/>
        <rdfs:comment xml:lang="it">Caratteristica o opzione progettata per ridurre barriere di accesso e migliorare la fruizione del videogioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Funzionalita di accessibilita</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaCognitiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaCognitiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Funzionalita di accessibilita relativa alla comprensione, all&apos;orientamento e alla gestione del carico cognitivo.</rdfs:comment>
        <rdfs:label xml:lang="it">Funzionalita cognitiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaMotoria -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaMotoria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Funzionalita di accessibilita relativa all&apos;interazione fisica con il sistema di gioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Funzionalita motoria</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaUditiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaUditiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Funzionalita di accessibilita relativa alla fruizione dei contenuti sonori o dialogici.</rdfs:comment>
        <rdfs:label xml:lang="it">Funzionalita uditiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaVisiva -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaVisiva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
        <rdfs:comment xml:lang="it">Funzionalita di accessibilita relativa alla percezione visiva dei contenuti.</rdfs:comment>
        <rdfs:label xml:lang="it">Funzionalita visiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#IndicatoriVisiviAudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#IndicatoriVisiviAudio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaUditiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che rappresenta eventi sonori tramite segnali visivi.</rdfs:comment>
        <rdfs:label xml:lang="it">Indicatori visivi audio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#IngrandimentoTesto -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#IngrandimentoTesto">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaVisiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che permette di aumentare la dimensione del testo visualizzato.</rdfs:comment>
        <rdfs:label xml:lang="it">Ingrandimento testo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#LivelloAccessibilita -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#LivelloAccessibilita">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AccessibilitaBase"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AccessibilitaElevata"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AccessibilitaMedia"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ConcettoDiClassificazione"/>
        <rdfs:comment xml:lang="it">Classe enumerata che rappresenta tre livelli sintetici di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">Livello di accessibilita</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ModalitaDaltonismo -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ModalitaDaltonismo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaVisiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che modifica colori o contrasti per supportare giocatori con difficolta nella distinzione cromatica.</rdfs:comment>
        <rdfs:label xml:lang="it">Modalita per daltonismo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Piattaforma -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Piattaforma">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ProfiloGiocatore"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Sistema hardware o software su cui un videogioco e disponibile.</rdfs:comment>
        <rdfs:label xml:lang="it">Piattaforma</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q241317"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ProfiloGiocatore -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ProfiloGiocatore">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Rappresentazione astratta di un giocatore o gruppo di giocatori con specifiche esigenze di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">Profilo giocatore</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Publisher -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Publisher">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Soggetto o organizzazione responsabile della pubblicazione o distribuzione commerciale di un videogioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Publisher</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1137109"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#RiduzioneStimoli -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#RiduzioneStimoli">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaCognitiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che limita elementi visivi, sonori o interattivi potenzialmente sovraccaricanti.</rdfs:comment>
        <rdfs:label xml:lang="it">Riduzione degli stimoli</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#RimappaturaComandi -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#RimappaturaComandi">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaMotoria"/>
        <rdfs:comment xml:lang="it">Funzionalita che consente di modificare l&apos;associazione tra azioni di gioco e dispositivi o pulsanti di input.</rdfs:comment>
        <rdfs:label xml:lang="it">Rimappatura dei comandi</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sottotitoli -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sottotitoli">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaUditiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che rende disponibili in forma testuale dialoghi o informazioni sonore.</rdfs:comment>
        <rdfs:label xml:lang="it">Sottotitoli</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#SottotitoliAvanzati -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#SottotitoliAvanzati">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sottotitoli"/>
        <rdfs:comment xml:lang="it">Sottotitoli arricchiti con informazioni aggiuntive, personalizzazione o indicazione dei parlanti.</rdfs:comment>
        <rdfs:label xml:lang="it">Sottotitoli avanzati</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sviluppatore -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Sviluppatore">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Soggetto o organizzazione responsabile dello sviluppo di un videogioco.</rdfs:comment>
        <rdfs:label xml:lang="it">Sviluppatore</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q210167"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#TutorialGuidato -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#TutorialGuidato">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaCognitiva"/>
        <rdfs:comment xml:lang="it">Funzionalita che accompagna il giocatore nell&apos;apprendimento di comandi, regole o obiettivi.</rdfs:comment>
        <rdfs:label xml:lang="it">Tutorial guidato</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco">
        <rdfs:comment xml:lang="it">Opera videoludica descritta dal punto di vista delle sue funzionalita di accessibilita e delle informazioni descrittive principali.</rdfs:comment>
        <rdfs:label xml:lang="it">Videogioco</rdfs:label>
        <skos:exactMatch rdf:resource="http://dbpedia.org/ontology/VideoGame"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibile -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAccessibile">
