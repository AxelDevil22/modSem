            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
        <rdfs:comment xml:lang="it">Videogioco che possiede almeno una funzionalita di accessibilita.</rdfs:comment>
        <rdfs:label xml:lang="it">Videogioco accessibile</rdfs:label>
    </owl:Class>
    


