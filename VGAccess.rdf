        <rdfs:label xml:lang="it">Videogioco accessibile per utenti con esigenze visive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAltamenteAccessibile -->

    <owl:Class rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#VideogiocoAltamenteAccessibile">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#Videogioco"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita"/>
                    </owl:Restriction>
                </owl:intersectionOf>
