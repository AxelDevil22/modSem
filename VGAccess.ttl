                                                           <http://example.org/vgaccess#supportaEsigenza> <http://example.org/vgaccess#RiduzioneBarriereMotorie> ;
                                                           rdfs:comment "Istanza di controlli semplificati presente nell'esempio Celeste."@it ;
                                                           rdfs:label "Controlli semplificati di Celeste"@it .


###  http://example.org/vgaccess#DifficoltaPersonalizzabileCeleste
<http://example.org/vgaccess#DifficoltaPersonalizzabileCeleste> rdf:type owl:NamedIndividual ,
                                                                         <http://example.org/vgaccess#DifficoltaPersonalizzabile> ,
                                                                         <http://example.org/vgaccess#FunzionalitaAccessibilita> ,
                                                                         <http://example.org/vgaccess#FunzionalitaCognitiva> ;
                                                                <http://example.org/vgaccess#eFunzionalitaDi> <http://example.org/vgaccess#Celeste> ;
                                                                <http://example.org/vgaccess#supportaEsigenza> <http://example.org/vgaccess#GestioneCaricoCognitivo> ;
                                                                rdfs:comment "Istanza di difficolta personalizzabile presente nell'esempio Celeste."@it ;
                                                                rdfs:label "Difficolta personalizzabile di Celeste"@it .


