        <rdfs:label xml:lang="it">Accessibilita elevata</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AccessibilitaMedia -->

