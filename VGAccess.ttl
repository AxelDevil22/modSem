@prefix : <http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vgaccess: <http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#> .
@base <http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#> .

<http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess> rdf:type owl:Ontology ;
                                                                      dc:creator "Alex Agliuzza"@it ;
                                                                      dc:date "2026-05-24"^^xsd:date ;
                                                                      dc:description "Ontologia per descrivere videogiochi in relazione alle funzionalita di accessibilita offerte, alle esigenze dei giocatori e ai profili utente supportati."@it ;
                                                                      dc:title "VGAccess: ontologia per la rappresentazione dell'accessibilita nei videogiochi"@it ;
                                                                      vann:preferredNamespacePrefix "vgaccess" ;
                                                                      vann:preferredNamespaceUri "<http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#>" ;
                                                                      rdfs:comment "Ontologia sviluppata come progetto di modellazione concettuale per il Web Semantico."@it ;
                                                                      rdfs:label "VGAccess"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


###  internal:anonymous-constants
<internal:anonymous-constants> rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#adattoAProfilo
vgaccess:adattoAProfilo rdf:type owl:ObjectProperty ;
                        rdfs:domain vgaccess:Videogioco ;
                        rdfs:range vgaccess:ProfiloGiocatore ;
                        rdfs:comment "Collega un videogioco a un profilo giocatore per cui il gioco puo essere considerato adatto."@it ;
                        rdfs:label "adatto a profilo"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#disponibileSu
vgaccess:disponibileSu rdf:type owl:ObjectProperty ;
                       rdfs:domain vgaccess:Videogioco ;
                       rdfs:range vgaccess:Piattaforma ;
                       rdfs:comment "Collega un videogioco alla piattaforma su cui e disponibile."@it ;
                       rdfs:label "disponibile su"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#eFunzionalitaDi
vgaccess:eFunzionalitaDi rdf:type owl:ObjectProperty ;
                         owl:inverseOf vgaccess:haFunzionalitaAccessibilita ;
                         rdfs:domain vgaccess:FunzionalitaAccessibilita ;
                         rdfs:range vgaccess:Videogioco ;
                         rdfs:comment "Collega una funzionalita di accessibilita al videogioco in cui e presente."@it ;
                         rdfs:label "e funzionalita di"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haEsigenzaAccessibilita
vgaccess:haEsigenzaAccessibilita rdf:type owl:ObjectProperty ;
                                 rdfs:domain vgaccess:ProfiloGiocatore ;
                                 rdfs:range vgaccess:EsigenzaAccessibilita ;
                                 rdfs:comment "Collega un profilo giocatore a una sua esigenza di accessibilita."@it ;
                                 rdfs:label "ha esigenza di accessibilita"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haFunzionalitaAccessibilita
vgaccess:haFunzionalitaAccessibilita rdf:type owl:ObjectProperty ;
                                     rdfs:domain vgaccess:Videogioco ;
                                     rdfs:range vgaccess:FunzionalitaAccessibilita ;
                                     rdfs:comment "Collega un videogioco a una funzionalita di accessibilita presente nel gioco."@it ;
                                     rdfs:label "ha funzionalita di accessibilita"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haLivelloAccessibilita
vgaccess:haLivelloAccessibilita rdf:type owl:ObjectProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain vgaccess:Videogioco ;
                                rdfs:range vgaccess:LivelloAccessibilita ;
                                rdfs:comment "Collega un videogioco a un unico livello sintetico di accessibilita."@it ;
                                rdfs:label "ha livello di accessibilita"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#piuSpecificoDi
vgaccess:piuSpecificoDi rdf:type owl:ObjectProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain vgaccess:FunzionalitaAccessibilita ;
                        rdfs:range vgaccess:FunzionalitaAccessibilita ;
                        rdfs:comment "Relazione transitiva usata per rappresentare gerarchie concettuali tra funzionalita o bisogni."@it ;
                        rdfs:label "piu specifico di"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#pubblicatoDa
vgaccess:pubblicatoDa rdf:type owl:ObjectProperty ;
                      rdfs:domain vgaccess:Videogioco ;
                      rdfs:range vgaccess:Publisher ;
                      rdfs:comment "Collega un videogioco al suo publisher."@it ;
                      rdfs:label "pubblicato da"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenza
vgaccess:supportaEsigenza rdf:type owl:ObjectProperty ;
                          rdfs:domain vgaccess:FunzionalitaAccessibilita ;
                          rdfs:range vgaccess:EsigenzaAccessibilita ;
                          rdfs:comment "Collega una funzionalita di accessibilita all'esigenza del giocatore che essa supporta."@it ;
                          rdfs:label "supporta esigenza"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#supportaEsigenzaGiocatore
vgaccess:supportaEsigenzaGiocatore rdf:type owl:ObjectProperty ,
                                            owl:AsymmetricProperty ,
                                            owl:IrreflexiveProperty ;
                                   rdfs:domain vgaccess:Videogioco ;
                                   rdfs:range vgaccess:EsigenzaAccessibilita ;
                                   owl:propertyChainAxiom ( vgaccess:haFunzionalitaAccessibilita
                                                            vgaccess:supportaEsigenza
                                                          ) ;
                                   rdfs:comment "Collega un videogioco a un'esigenza del giocatore inferita tramite le sue funzionalita di accessibilita."@it ;
                                   rdfs:label "supporta esigenza del giocatore"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#sviluppatoDa
vgaccess:sviluppatoDa rdf:type owl:ObjectProperty ;
                      rdfs:domain vgaccess:Videogioco ;
                      rdfs:range vgaccess:Sviluppatore ;
                      rdfs:comment "Collega un videogioco al suo sviluppatore."@it ;
                      rdfs:label "sviluppato da"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haAnnoPubblicazione
vgaccess:haAnnoPubblicazione rdf:type owl:DatatypeProperty ;
                             rdfs:domain vgaccess:Videogioco ;
                             rdfs:range xsd:gYear ;
                             rdfs:comment "Anno di pubblicazione del videogioco."@it ;
                             rdfs:label "ha anno di pubblicazione"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haDescrizioneBreve
vgaccess:haDescrizioneBreve rdf:type owl:DatatypeProperty ;
                            rdfs:domain vgaccess:Videogioco ;
                            rdfs:range rdf:langString ;
                            rdfs:comment "Breve descrizione testuale del videogioco o delle sue caratteristiche rilevanti."@it ;
                            rdfs:label "ha descrizione breve"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haPunteggioAccessibilita
vgaccess:haPunteggioAccessibilita rdf:type owl:DatatypeProperty ;
                                  rdfs:domain vgaccess:Videogioco ;
                                  rdfs:range xsd:integer ;
                                  rdfs:comment "Valore numerico sintetico usato per indicare il livello di accessibilita del videogioco."@it ;
                                  rdfs:label "ha punteggio di accessibilita"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#haTitoloPrincipale
vgaccess:haTitoloPrincipale rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain vgaccess:Videogioco ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Titolo principale del videogioco, espresso come stringa."@it ;
                            rdfs:label "ha titolo principale"@it .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AltoContrasto
vgaccess:AltoContrasto rdf:type owl:Class ;
                       rdfs:subClassOf vgaccess:FunzionalitaVisiva ;
                       owl:disjointWith vgaccess:AssistMode ,
                                        vgaccess:ControlliSemplificati ,
                                        vgaccess:DifficoltaPersonalizzabile ,
                                        vgaccess:EsigenzaAccessibilita ,
                                        vgaccess:EsigenzaCognitiva ,
                                        vgaccess:EsigenzaMotoria ,
                                        vgaccess:EsigenzaUditiva ,
                                        vgaccess:EsigenzaVisiva ,
                                        vgaccess:FunzionalitaCognitiva ,
                                        vgaccess:FunzionalitaMotoria ,
                                        vgaccess:FunzionalitaUditiva ,
                                        vgaccess:IndicatoriVisiviAudio ,
                                        vgaccess:IngrandimentoTesto ,
                                        vgaccess:LivelloAccessibilita ,
                                        vgaccess:ModalitaDaltonismo ,
                                        vgaccess:Piattaforma ,
                                        vgaccess:ProfiloGiocatore ,
                                        vgaccess:RiduzioneStimoli ,
                                        vgaccess:RimappaturaComandi ,
                                        vgaccess:Sottotitoli ,
                                        vgaccess:SottotitoliAvanzati ,
                                        vgaccess:TutorialGuidato ,
                                        vgaccess:Videogioco ,
                                        vgaccess:VideogiocoAccessibile ,
                                        vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                        vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                        vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                        vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                        vgaccess:VideogiocoAltamenteAccessibile ;
                       rdfs:comment "Funzionalita che aumenta il contrasto visivo tra elementi di gioco, interfaccia e sfondo."@it ;
                       rdfs:label "Alto contrasto"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#AssistMode
vgaccess:AssistMode rdf:type owl:Class ;
                    rdfs:subClassOf vgaccess:FunzionalitaMotoria ;
                    owl:disjointWith vgaccess:ControlliSemplificati ,
                                     vgaccess:DifficoltaPersonalizzabile ,
                                     vgaccess:EsigenzaAccessibilita ,
                                     vgaccess:EsigenzaCognitiva ,
                                     vgaccess:EsigenzaMotoria ,
                                     vgaccess:EsigenzaUditiva ,
                                     vgaccess:EsigenzaVisiva ,
                                     vgaccess:FunzionalitaCognitiva ,
                                     vgaccess:FunzionalitaUditiva ,
                                     vgaccess:FunzionalitaVisiva ,
                                     vgaccess:IndicatoriVisiviAudio ,
                                     vgaccess:IngrandimentoTesto ,
                                     vgaccess:LivelloAccessibilita ,
                                     vgaccess:ModalitaDaltonismo ,
                                     vgaccess:Piattaforma ,
                                     vgaccess:ProfiloGiocatore ,
                                     vgaccess:RiduzioneStimoli ,
                                     vgaccess:RimappaturaComandi ,
                                     vgaccess:Sottotitoli ,
                                     vgaccess:SottotitoliAvanzati ,
                                     vgaccess:TutorialGuidato ,
                                     vgaccess:Videogioco ,
                                     vgaccess:VideogiocoAccessibile ,
                                     vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                     vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                     vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                     vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                     vgaccess:VideogiocoAltamenteAccessibile ;
                    rdfs:comment "Modalita di assistenza che modifica alcune regole o parametri di gioco per ridurre barriere di interazione."@it ;
                    rdfs:label "Assist mode"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#ControlliSemplificati
vgaccess:ControlliSemplificati rdf:type owl:Class ;
                               rdfs:subClassOf vgaccess:FunzionalitaMotoria ;
                               owl:disjointWith vgaccess:DifficoltaPersonalizzabile ,
                                                vgaccess:EsigenzaAccessibilita ,
                                                vgaccess:EsigenzaCognitiva ,
                                                vgaccess:EsigenzaMotoria ,
                                                vgaccess:EsigenzaUditiva ,
                                                vgaccess:EsigenzaVisiva ,
                                                vgaccess:FunzionalitaCognitiva ,
                                                vgaccess:FunzionalitaUditiva ,
                                                vgaccess:FunzionalitaVisiva ,
                                                vgaccess:IndicatoriVisiviAudio ,
                                                vgaccess:IngrandimentoTesto ,
                                                vgaccess:LivelloAccessibilita ,
                                                vgaccess:ModalitaDaltonismo ,
                                                vgaccess:Piattaforma ,
                                                vgaccess:ProfiloGiocatore ,
                                                vgaccess:RiduzioneStimoli ,
                                                vgaccess:RimappaturaComandi ,
                                                vgaccess:Sottotitoli ,
                                                vgaccess:SottotitoliAvanzati ,
                                                vgaccess:TutorialGuidato ,
                                                vgaccess:Videogioco ,
                                                vgaccess:VideogiocoAccessibile ,
                                                vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                                vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                                vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                                vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                                vgaccess:VideogiocoAltamenteAccessibile ;
                               rdfs:comment "Funzionalita che riduce la complessita o la precisione richiesta per l'interazione motoria."@it ;
                               rdfs:label "Controlli semplificati"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#DifficoltaPersonalizzabile
vgaccess:DifficoltaPersonalizzabile rdf:type owl:Class ;
                                    rdfs:subClassOf vgaccess:FunzionalitaCognitiva ;
                                    owl:disjointWith vgaccess:EsigenzaAccessibilita ,
                                                     vgaccess:EsigenzaCognitiva ,
                                                     vgaccess:EsigenzaMotoria ,
                                                     vgaccess:EsigenzaUditiva ,
                                                     vgaccess:EsigenzaVisiva ,
                                                     vgaccess:FunzionalitaMotoria ,
                                                     vgaccess:FunzionalitaUditiva ,
                                                     vgaccess:FunzionalitaVisiva ,
                                                     vgaccess:IndicatoriVisiviAudio ,
                                                     vgaccess:IngrandimentoTesto ,
                                                     vgaccess:LivelloAccessibilita ,
                                                     vgaccess:ModalitaDaltonismo ,
                                                     vgaccess:Piattaforma ,
                                                     vgaccess:ProfiloGiocatore ,
                                                     vgaccess:RiduzioneStimoli ,
                                                     vgaccess:RimappaturaComandi ,
                                                     vgaccess:Sottotitoli ,
                                                     vgaccess:SottotitoliAvanzati ,
                                                     vgaccess:TutorialGuidato ,
                                                     vgaccess:Videogioco ,
                                                     vgaccess:VideogiocoAccessibile ,
                                                     vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                                     vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                                     vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                                     vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                                     vgaccess:VideogiocoAltamenteAccessibile ;
                                    rdfs:comment "Funzionalita che consente di modificare parametri della difficolta per adattare l'esperienza alle esigenze del giocatore."@it ;
                                    rdfs:label "Difficolta personalizzabile"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaAccessibilita
vgaccess:EsigenzaAccessibilita rdf:type owl:Class ;
                               owl:disjointWith vgaccess:FunzionalitaAccessibilita ,
                                                vgaccess:FunzionalitaCognitiva ,
                                                vgaccess:FunzionalitaMotoria ,
                                                vgaccess:FunzionalitaUditiva ,
                                                vgaccess:FunzionalitaVisiva ,
                                                vgaccess:IndicatoriVisiviAudio ,
                                                vgaccess:IngrandimentoTesto ,
                                                vgaccess:LivelloAccessibilita ,
                                                vgaccess:ModalitaDaltonismo ,
                                                vgaccess:Piattaforma ,
                                                vgaccess:ProfiloGiocatore ,
                                                vgaccess:RiduzioneStimoli ,
                                                vgaccess:RimappaturaComandi ,
                                                vgaccess:Sottotitoli ,
                                                vgaccess:SottotitoliAvanzati ,
                                                vgaccess:TutorialGuidato ,
                                                vgaccess:Videogioco ,
                                                vgaccess:VideogiocoAccessibile ,
                                                vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                                vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                                vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                                vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                                vgaccess:VideogiocoAltamenteAccessibile ;
                               rdfs:comment "Necessita o requisito del giocatore a cui una funzionalita di accessibilita puo rispondere."@it ;
                               rdfs:label "Esigenza di accessibilita"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaCognitiva
vgaccess:EsigenzaCognitiva rdf:type owl:Class ;
                           rdfs:subClassOf vgaccess:EsigenzaAccessibilita ;
                           owl:disjointWith vgaccess:EsigenzaMotoria ,
                                            vgaccess:EsigenzaUditiva ,
                                            vgaccess:EsigenzaVisiva ,
                                            vgaccess:FunzionalitaAccessibilita ,
                                            vgaccess:FunzionalitaCognitiva ,
                                            vgaccess:FunzionalitaMotoria ,
                                            vgaccess:FunzionalitaUditiva ,
                                            vgaccess:FunzionalitaVisiva ,
                                            vgaccess:IndicatoriVisiviAudio ,
                                            vgaccess:IngrandimentoTesto ,
                                            vgaccess:LivelloAccessibilita ,
                                            vgaccess:ModalitaDaltonismo ,
                                            vgaccess:Piattaforma ,
                                            vgaccess:ProfiloGiocatore ,
                                            vgaccess:RiduzioneStimoli ,
                                            vgaccess:RimappaturaComandi ,
                                            vgaccess:Sottotitoli ,
                                            vgaccess:SottotitoliAvanzati ,
                                            vgaccess:TutorialGuidato ,
                                            vgaccess:Videogioco ,
                                            vgaccess:VideogiocoAccessibile ,
                                            vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                            vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                            vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                            vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                            vgaccess:VideogiocoAltamenteAccessibile ;
                           rdfs:comment "Esigenza legata alla comprensione, alla memoria, all'attenzione o alla gestione della complessita."@it ;
                           rdfs:label "Esigenza cognitiva"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaMotoria
vgaccess:EsigenzaMotoria rdf:type owl:Class ;
                         rdfs:subClassOf vgaccess:EsigenzaAccessibilita ;
                         owl:disjointWith vgaccess:EsigenzaUditiva ,
                                          vgaccess:EsigenzaVisiva ,
                                          vgaccess:FunzionalitaAccessibilita ,
                                          vgaccess:FunzionalitaCognitiva ,
                                          vgaccess:FunzionalitaMotoria ,
                                          vgaccess:FunzionalitaUditiva ,
                                          vgaccess:FunzionalitaVisiva ,
                                          vgaccess:IndicatoriVisiviAudio ,
                                          vgaccess:IngrandimentoTesto ,
                                          vgaccess:LivelloAccessibilita ,
                                          vgaccess:ModalitaDaltonismo ,
                                          vgaccess:Piattaforma ,
                                          vgaccess:ProfiloGiocatore ,
                                          vgaccess:RiduzioneStimoli ,
                                          vgaccess:RimappaturaComandi ,
                                          vgaccess:Sottotitoli ,
                                          vgaccess:SottotitoliAvanzati ,
                                          vgaccess:TutorialGuidato ,
                                          vgaccess:Videogioco ,
                                          vgaccess:VideogiocoAccessibile ,
                                          vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                          vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                          vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                          vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                          vgaccess:VideogiocoAltamenteAccessibile ;
                         rdfs:comment "Esigenza legata all'interazione fisica con controlli, periferiche o azioni di gioco."@it ;
                         rdfs:label "Esigenza motoria"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaUditiva
vgaccess:EsigenzaUditiva rdf:type owl:Class ;
                         rdfs:subClassOf vgaccess:EsigenzaAccessibilita ;
                         owl:disjointWith vgaccess:EsigenzaVisiva ,
                                          vgaccess:FunzionalitaAccessibilita ,
                                          vgaccess:FunzionalitaCognitiva ,
                                          vgaccess:FunzionalitaMotoria ,
                                          vgaccess:FunzionalitaUditiva ,
                                          vgaccess:FunzionalitaVisiva ,
                                          vgaccess:IndicatoriVisiviAudio ,
                                          vgaccess:IngrandimentoTesto ,
                                          vgaccess:LivelloAccessibilita ,
                                          vgaccess:ModalitaDaltonismo ,
                                          vgaccess:Piattaforma ,
                                          vgaccess:ProfiloGiocatore ,
                                          vgaccess:RiduzioneStimoli ,
                                          vgaccess:RimappaturaComandi ,
                                          vgaccess:Sottotitoli ,
                                          vgaccess:SottotitoliAvanzati ,
                                          vgaccess:TutorialGuidato ,
                                          vgaccess:Videogioco ,
                                          vgaccess:VideogiocoAccessibile ,
                                          vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                          vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                          vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                          vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                          vgaccess:VideogiocoAltamenteAccessibile ;
                         rdfs:comment "Esigenza legata alla fruizione di suoni, dialoghi e feedback audio."@it ;
                         rdfs:label "Esigenza uditiva"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#EsigenzaVisiva
vgaccess:EsigenzaVisiva rdf:type owl:Class ;
                        rdfs:subClassOf vgaccess:EsigenzaAccessibilita ;
                        owl:disjointWith vgaccess:FunzionalitaAccessibilita ,
                                         vgaccess:FunzionalitaCognitiva ,
                                         vgaccess:FunzionalitaMotoria ,
                                         vgaccess:FunzionalitaUditiva ,
                                         vgaccess:FunzionalitaVisiva ,
                                         vgaccess:IndicatoriVisiviAudio ,
                                         vgaccess:IngrandimentoTesto ,
                                         vgaccess:LivelloAccessibilita ,
                                         vgaccess:ModalitaDaltonismo ,
                                         vgaccess:Piattaforma ,
                                         vgaccess:ProfiloGiocatore ,
                                         vgaccess:RiduzioneStimoli ,
                                         vgaccess:RimappaturaComandi ,
                                         vgaccess:Sottotitoli ,
                                         vgaccess:SottotitoliAvanzati ,
                                         vgaccess:TutorialGuidato ,
                                         vgaccess:Videogioco ,
                                         vgaccess:VideogiocoAccessibile ,
                                         vgaccess:VideogiocoAccessibilePerUtentiCognitivi ,
                                         vgaccess:VideogiocoAccessibilePerUtentiMotori ,
                                         vgaccess:VideogiocoAccessibilePerUtentiUditivi ,
                                         vgaccess:VideogiocoAccessibilePerUtentiVisivi ,
                                         vgaccess:VideogiocoAltamenteAccessibile ;
                        rdfs:comment "Esigenza legata alla percezione visiva dei contenuti di gioco."@it ;
                        rdfs:label "Esigenza visiva"@it .


###  http://www.semanticweb.org/alexagliuzza/ontologies/2026/4/VGAccess#FunzionalitaAccessibilita
vgaccess:FunzionalitaAccessibilita rdf:type owl:Class ;
                                   owl:disjointWith vgaccess:LivelloAccessibilita ,
                                                    vgaccess:Piattaforma ,
